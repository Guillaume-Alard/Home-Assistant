# ── Sentinel : configuration ─────────────────────────────────────────────
# Copiez ce fichier en `.env` puis remplissez au minimum ANTHROPIC_API_KEY.
# Ne committez JAMAIS le fichier .env (il est ignoré par git).

# ── Obligatoire ──────────────────────────────────────────────────────────
# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────
# Modèle du cerveau. Alternatives : claude-opus-5 (plus capable, plus cher),
# claude-haiku-4-5 (économique). Voir docs/ARCHITECTURE.md.
SENTINEL_MODEL=claude-sonnet-5
# Longueur max. d'une réponse (les réponses vocales sont volontairement courtes)
SENTINEL_MAX_TOKENS=1024
# Profondeur de réflexion : low | medium | high (low = latence et coût minimaux,
# adapté à la conversation courante ; montez pour des réponses plus travaillées)
SENTINEL_EFFORT=low
# Nombre de messages d'historique envoyés au modèle à chaque tour
SENTINEL_HISTORY_WINDOW=30

# ── Multi-LLM : modèles alternatifs (optionnel) ────────────────────────────
# Claude (ci-dessus) reste le cerveau de RÉFÉRENCE : c'est lui qui gère le mieux
# les outils, et lui seul fait la recherche web. Tu peux brancher d'autres
# modèles — utile pour une API gratuite ou à moindre coût — puis basculer À CHAUD
# dans le cockpit (Paramètres › Connexions › Modèle actif). Un modèle alternatif a
# EXACTEMENT les mêmes outils que Claude et la même sécurité : toute action reste
# une proposition que tu valides, rien ne change aux niveaux de confiance.
# Chaque fournisseur s'active en posant SA clé ci-dessous ; le modèle est préréglé
# mais tu peux le remplacer par celui de ton choix. Voir docs/MULTI-LLM.md.
#
# ChatGPT (OpenAI) — https://platform.openai.com/api-keys (payant, comme Claude)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Google Gemini — https://aistudio.google.com/apikey (offre gratuite généreuse)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq — https://console.groq.com/keys (gratuit, très rapide)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter — https://openrouter.ai/keys (un seul compte, des dizaines de modèles ;
# l'identifiant est de la forme « éditeur/modèle », voir openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Fournisseur actif au démarrage : claude (défaut) | openai | gemini | groq | openrouter.
# Vide = claude. Le choix fait dans le cockpit prend le dessus et est mémorisé.
SENTINEL_LLM_PROVIDER=

# ── Réseau ───────────────────────────────────────────────────────────────
# Port de l'interface web (HTTPS) sur le LAN
SENTINEL_PORT=8443
# HTTPS : on = certificat auto-signé généré automatiquement (ou vos propres
# certificats déposés dans data/certs/). off = HTTP simple, UNIQUEMENT derrière
# un reverse proxy qui gère lui-même le TLS (le micro exige un contexte sécurisé).
SENTINEL_TLS=on
# Adresses supplémentaires à inscrire dans le certificat auto-signé (SAN).
# AJOUTE-Y TON IP LAN, sinon les clients stricts (iPhone) refusent le WebSocket
# sécurisé. Format openssl, séparés par des virgules. Ex. : IP:192.168.0.212
# (après modif : supprime data/certs/sentinel.* puis redémarre pour régénérer).
SENTINEL_TLS_SANS=

# ── Voix ─────────────────────────────────────────────────────────────────
# Modèle faster-whisper : small-int8 (défaut CPU) | medium (GPU conseillé) | tiny-int8…
WHISPER_MODEL=small-int8
# Voix Piper française : fr_FR-siwis-medium (défaut) | fr_FR-upmc-medium | …
PIPER_VOICE=fr_FR-siwis-medium
# Voix de Luna : piper (défaut, instantané) | cloned (voix clonée locale, repli
# Piper auto). « cloned » nécessite le service sentinel-xtts (profil « voix ») et
# un échantillon dans config/voix/voices/luna.wav — voir docs/VOICE.md.
TTS_ENGINE=piper
# CLONED_TTS_URL=http://sentinel-xtts:8000
# CLONED_TTS_VOICE=luna

# ── Mémoire persistante (Phase 1) ──────────────────────────────────────────
# Luna retient d'elle-même ce qui est durablement utile (préférences, habitudes,
# style de langage, faits stables) pour personnaliser ses réponses. C'est de
# l'enrichissement de contexte : rien n'agit sur la maison, rien ne quitte Nebula.
# Tu vois, ajoutes et supprimes tout dans Paramètres › Mémoire. Voir docs/MEMOIRE.md.
# on (défaut) = mémoire active ; off = souvenirs conservés mais plus injectés.
SENTINEL_MEMORY=on
# Nombre de souvenirs (les plus récents) injectés dans le contexte à chaque tour
SENTINEL_MEMORY_WINDOW=60

# ── Recherche web (Phase 4) ────────────────────────────────────────────────
# Luna peut chercher sur le web (actualité, connaissances externes) et CITER ses
# sources, via l'outil de recherche natif d'Anthropic — aucun compte ni service à
# ajouter, ça utilise ta clé ANTHROPIC_API_KEY. Facturé par Anthropic (~1 ct par
# recherche). Réservé aux personnes reconnues (owner + maisonnée). Contenu web
# traité comme de l'information à citer, jamais comme des ordres. Voir docs/RECHERCHE-WEB.md.
# on (défaut) = active ; off = désactivée.
SENTINEL_WEB_SEARCH=on
# Nombre maximum de recherches par tour de conversation (garde-fou coût)
SENTINEL_WEB_SEARCH_MAX=5

# ── Auto-amélioration encadrée (Phase 6) ───────────────────────────────────
# Luna peut te PROPOSER des améliorations de son propre code / sa configuration,
# toujours sous forme d'un DIFF que tu relis puis appliques toi-même (Paramètres ›
# Évolutions). Elle n'applique JAMAIS rien seule, et sa politique refuse d'office
# tout diff touchant un garde-fou de sécurité (niveaux de confiance, moteur
# d'actions, isolation de l'atelier, secrets) ou introduisant un secret. Réservé
# à Guillaume. Voir docs/AUTO-AMELIORATION.md.
# on (défaut) = outils de proposition disponibles ; off = retirés (les propositions
# déjà faites restent lisibles dans le cockpit).
SENTINEL_SELF_IMPROVE=on

# ── Proactivité contextuelle (Phase 7) ─────────────────────────────────────
# Luna observe l'état de la maison + l'heure et te SUGGÈRE (jamais n'exécute) :
# un volet resté ouvert le soir, des lumières allumées tard, personne à la maison…
# Une suggestion actionnable ne devient une action qu'en DEUX temps humains : ton
# accord → une proposition → ton approbation. Les alertes de sécurité sont dites à
# voix haute, les simples constats se taisent la nuit. Nécessite Nova (HA_URL).
# Règle fine (heures calmes, seuils) : config/proactive.yml. Voir docs/PROACTIVITE.md.
# on (défaut) = veilleur actif ; off = coupé.
SENTINEL_PROACTIVE=on
# Intervalle (secondes) entre deux évaluations de fond (en plus des changements d'état)
SENTINEL_PROACTIVE_INTERVAL=150

# ── Scénarios & routines (Phase 8) ─────────────────────────────────────────
# Luna te PROPOSE des routines (séquences d'actions nommées, ex. « Bonne nuit »)
# depuis tes habitudes (analyse du journal des actions) ou la conversation ; tu
# les ACTIVES dans le cockpit, puis tu les déclenches d'un mot. Une routine ne
# contient JAMAIS d'action sensible (ni serrure, ni alarme). Nécessite Nova.
# Voir docs/ROUTINES.md. on (défaut) = actif ; off = plus de détection ni d'outils.
SENTINEL_ROUTINES=on
# Habitude : nb de jours distincts où un même scénario doit revenir pour être proposé
SENTINEL_ROUTINE_MIN_DAYS=3
# Fenêtre d'analyse des habitudes (jours)
SENTINEL_ROUTINE_LOOKBACK=21

# ── Musique multi-pièces (Phase 9) ─────────────────────────────────────────
# Luna pilote tes lecteurs media_player de Nova (Spotify, Sonos, Chromecast,
# enceintes…) : lecture/pause, volume, source, et transfert d'une pièce à l'autre.
# Aucun compte ni jeton en plus — tout passe par Nova, sur le LAN. Préréglages et
# pièce par défaut (« mets du jazz ») : config/media.yml. Voir docs/MUSIQUE.md.
# on (défaut) = outils + tuile musique ; off = retirés.
SENTINEL_MUSIC=on

# ── Minuteurs & rappels vocaux (Phase 10) ──────────────────────────────────
# « minuteur 10 minutes », « rappelle-moi dans 20 min de sortir le plat »,
# « à 18h d'appeler le garage ». 100% LOCAL (rien ne quitte Nebula) ; à
# l'échéance, Luna carillonne et l'annonce. Voir docs/RAPPELS.md.
# on (défaut) = outils + tuile ⏰ ; off = retirés.
SENTINEL_REMINDERS=on

# ── Notifications mobiles (Phase 14) ───────────────────────────────────────
# Luna te joint sur ton TÉLÉPHONE via l'app Home Assistant (companion) quand tu
# n'es pas devant le cockpit : un rappel qui sonne, une alerte de sécurité.
# Communication seule — jamais de pilotage de la maison ; la poussée passe par le
# moteur d'actions (journalisée). Voir docs/NOTIFICATIONS.md.
# Le service Nova à utiliser : « mobile_app_<ton_appareil> » (SANS le préfixe
# « notify. »). Trouve-le dans Nova → Outils de développement → Actions, en
# tapant « notify. ». Vide = notifications désactivées.
SENTINEL_NOTIFY_SERVICE=
# Que pousser (défauts : rappels + alertes de sécurité oui).
SENTINEL_NOTIFY_REMINDERS=on
SENTINEL_NOTIFY_ALERTS=on

# ── Reconnaissance de locuteur (Phase 2) ───────────────────────────────────
# Luna reconnaît qui parle (Guillaume, conjointe, fils…) pour personnaliser son
# discours et sa mémoire, et rester PRUDENTE avec une voix inconnue (conversation
# et lecture d'état seulement). Elle ne débloque JAMAIS rien de sensible : le
# déverrouillage et le désarmement restent réservés à l'interface, pour tout le
# monde. Empreinte extraite par le service local « sentinel-speaker » (CPU).
# Pour DÉSACTIVER complètement : décommente la ligne vide ci-dessous (SPEAKER_HOST=)
# — Luna traite alors tout le monde comme le propriétaire, comme avant. Enrôlement
# des voix dans Paramètres › Profils vocaux. Voir docs/PHASE2-LOCUTEUR.md.
# SPEAKER_HOST=
# Seuil de similarité (0..1) pour reconnaître une voix. Plus haut = plus strict
# (moins de confusions, mais plus de « non reconnu »). Défaut 0.75.
SPEAKER_THRESHOLD=0.75

# ── Mot d'éveil (Phase 5A) ─────────────────────────────────────────────────
# Modèle openWakeWord préchargé. « hey_jarvis » est fourni avec l'image ; pour
# un mot personnalisé (« sentinel »), voir config/wakewords/README.md.
WAKEWORD_MODEL=hey_jarvis

# ── Agent conversationnel Assist (Phase 5B) ─────────────────────────────────
# Jeton porteur protégeant l'API compatible OpenAI (/v1/chat/completions) qui
# permet à Nova (intégration HACS « Extended OpenAI Conversation »), à l'app HA
# et aux satellites Assist de parler au cerveau de Sentinel. Vide = désactivé.
# Génère-en un au hasard : `openssl rand -hex 24`. Voir docs/ASSIST.md.
SENTINEL_ASSIST_TOKEN=

# ── Divers ───────────────────────────────────────────────────────────────
TZ=Europe/Paris
LOG_LEVEL=INFO

# ── Home Assistant (Nova) ────────────────────────────────────────────────
# URL de Nova, ex. http://192.168.1.10:8123 — et jeton longue durée (compte admin)
HA_URL=
HA_TOKEN=
